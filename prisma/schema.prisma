// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADMIN
}

enum BookingStatus {
  BOOKED
  PENDING
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(CLIENT)

  // Custom fields from your auth config
  avatarUrl String?
  phone     String?

  // Admin plugin fields
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]
  bookings Booking[]

  profile ClientProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments FormAssignment[]  // <-- Must be present
  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin plugin field (used for impersonation)
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Provider {
  id              String @id @default(cuid())
  name            String // e.g., "Dr. Smith" or "Room 1"
  hapioResourceId String @unique // Maps to Hapio's Resource ID
  // Note: We don't store Location/Service here if there's only 1 for the whole app.
  // Just put the new Location/Service IDs in your .env file once generated!
}

model Booking {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  hapioBookingId String @unique // Allows you to cancel/confirm in Hapio

  status BookingStatus @default(PENDING)

  zoomMeetingId String?
  zoomJoinUrl   String?

  startsAt DateTime
  endsAt   DateTime

  adminNote String? // For your admin blocks
}

model Form {
  id          String           @id @default(cuid())
  key         String           @unique
  title       String
  active      Boolean          @default(true)
  submissions FormSubmission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  formAssignments FormAssignment[]
}

enum FormStatus {
  PENDING // Sent or assigned, waiting on client
  COMPLETED // Submitted
  EXPIRED // Optional: if you want to explicitly mark expired invites
}

model FormAssignment {
  id     String     @id @default(cuid())
  token  String     @unique @default(cuid()) // Replaces your Redis UUID!
  status FormStatus @default(PENDING)

  // Pre-registration info (from firstContactAction)
  email   String
  name    String?
  message String?

  // Linked Form (Required)
  formId String
  form   Form   @relation(fields: [formId], references: [id])

  // Linked ClientProfile (Optional at first! Attached once they register/submit)
  profileId String?
  profile   ClientProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Resulting submission (1-to-1 when completed)
  submission FormSubmission?

  expiresAt DateTime // e.g., now() + 7 days
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([profileId])
}

model FormSubmission {
  id           String         @id @default(cuid())
  assignmentId String         @unique
  assignment   FormAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  profileId String
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  formId   String
  form     Form   @relation(fields: [formId], references: [id])
  formSlug String
  data     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ZoomConnection {
  id              String    @id @default("singleton")
  refreshToken    String
  accessToken     String?
  accessExpiresAt DateTime?
  updatedAt       DateTime  @updatedAt
}
